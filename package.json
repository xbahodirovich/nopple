{
  "name": "nopple",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types server/main.ts",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --experimental-strip-types --test src/project/*.test.ts src/editor/*.test.ts server/*.test.ts",
    "test:browser": "node scripts/check-browser.mjs",
    "test:editor": "node scripts/check-editor.mjs",
    "lint": "tsc --noEmit",
    "test:prompts": "node --experimental-strip-types scripts/test-prompts.mjs",
    "test:alpha": "node scripts/check-alpha.mjs",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:studio": "node scripts/check-studio.mjs",
    "test:selection": "node scripts/check-selection.mjs",
    "test:courtyard": "node scripts/check-courtyard.mjs",
    "test:languages": "node scripts/check-nopple.mjs",
    "test:warm": "node scripts/check-warm.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
